{
  "name": "Portsmouth Uni Dashboard",
  "short_name": "Uni Dash",
  "description": "Quick student portal links, timetables, Moodle, IT services, and interactive campus map for the University of Portsmouth.",
  "start_url": "/uni",
  "id": "/uni",
  "scope": "/uni",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0c1422",
  "theme_color": "#0c1422",
  "categories": ["education", "utilities", "productivity"],
  "icons": [
    {
      "src": "/icons/uni-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/uni-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/uni.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable any"
    }
  ]
}
